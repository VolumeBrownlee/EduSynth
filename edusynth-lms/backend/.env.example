# EduSynth Enterprise — Backend Environment Configuration
# Copy this file to ".env" and fill in your REAL values.
# The real .env is git-ignored and must NEVER be committed.

SETUP_TOKEN=replace-with-a-random-token

# ── Server ──
PORT=5000
NODE_ENV=development

# ── MongoDB ──
# Your own Atlas connection string. Rotate the password if it was ever exposed.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Edu

# ── JWT ──
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# ── Google Gemini AI ──
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-gemini-api-key

# ── File Upload ──
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# ── Security ──
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS ──
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
